# ---- PostgreSQL (business data) ----
# Leave unset to fall back to a local SQLite file at data/medchain_dev.sqlite3
DATABASE_URL=postgresql+psycopg2://medchain:medchain@postgres:5432/medchain

# ---- MongoDB (blockchain ledger + audit/provenance documents) ----
# Leave unset to fall back to a local JSON file at data/blockchain_fallback.json
MONGODB_URL=mongodb://mongo:27017
MONGODB_DB=medchain

# ---- InfluxDB (cold-chain + GPS time-series telemetry) ----
# Leave unset to fall back to local JSONL files under data/telemetry/
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=medchain-dev-token
INFLUX_ORG=medchain
INFLUX_BUCKET=telemetry

# ---- Auth ----
JWT_SECRET=change-me-in-production

# ---- Misc ----
CORS_ORIGINS=*
PORT=5000
